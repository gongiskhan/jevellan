  "nextBriefSection": "\n\n(note)\nNote: for divide, use exactly the error message \"Cannot divide by zero\".\n\nCorrection: do not add power. Only subtract and divide are wanted; remove power if you already added it.\n\n",
  "finalSource": "export function sum(a: number, b: number): number {\n  return a + b;\n}\n\nexport function subtract(a: number, b: number): number {\n  return a - b;\n}\n\nexport function divide(a: number, b: number): number {\n  if (b === 0) {\n    throw new Error('Cannot divide by zero');\n  }\n  return a / b;\n}\n",
